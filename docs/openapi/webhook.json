{
 "tag": {
  "name": "webhook",
  "description": "Capture inbound webhooks from a system under test and read them back."
 },
 "paths": {
  "/webhook/receive": {
   "get": {
    "tags": [
     "webhook"
    ],
    "operationId": "webhookReceive",
    "summary": "Capture an inbound webhook (any method)",
    "description": "Point the system under test's webhook URL here. Stores the whole request - method, query parameters (other than key and status), headers, source IP, and body - under the namespace key. JSON bodies are also returned parsed as 'json'; non-UTF-8 bodies are kept as bodyBase64. Bodies over 300 KB are truncated (bodyTruncated:true). No pre-registration: any key works. Answers with HTTP 'status' (default 200) so you can test the sender's retry behaviour. Accepts GET, POST, PUT, PATCH and DELETE. Captured events expire after 30 days.",
    "parameters": [
     {
      "name": "key",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string"
      },
      "description": "Namespace, usually one per test run. 1-128 characters: letters, digits and . _ - : @ + =, starting with a letter, digit or +. Case-sensitive.",
      "example": "run-7Q2K9ZX4M1"
     },
     {
      "name": "status",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "default": 200,
       "minimum": 200,
       "maximum": 599
      },
      "description": "HTTP status to answer with, 200-599. Default 200. 204/304 answer with no body."
     }
    ],
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "required": [
          "received",
          "key",
          "seq",
          "receivedTime",
          "status"
         ],
         "properties": {
          "received": {
           "type": "boolean"
          },
          "key": {
           "type": "string"
          },
          "seq": {
           "type": "string"
          },
          "receivedTime": {
           "type": "integer"
          },
          "status": {
           "type": "integer"
          }
         }
        },
        "example": {
         "received": true,
         "key": "run-7Q2K9ZX4M1",
         "seq": "001759112345678-0042817",
         "receivedTime": 1759112345,
         "status": 200
        }
       }
      }
     },
     "2XX": {
      "description": "The receipt, answered with the HTTP status you chose with status= (204 and 304 have no body).",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
