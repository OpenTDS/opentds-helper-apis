            }
           }
          }
         }
        },
        "example": {
         "key": "Login",
         "source": "lifetime",
         "pass": false,
         "failed": 2,
         "checks": [
          {
           "check": "p90lt",
           "statistic": "p90",
           "actual": 409.7182,
           "operator": "<",
           "threshold": 300.0,
           "pass": false
          },
          {
           "check": "errorratelt",
           "statistic": "errorRate",
           "actual": 0.049834,
           "operator": "<",
           "threshold": 0.01,
           "pass": false
          }
         ],
         "summary": {
          "count": 301,
          "errors": 15,
          "errorRate": 0.049834,
          "min": 85.7,
          "max": 743.4,
          "mean": 286.4439,
