     }
    },
    "x-free-form-query": {
     "description": "Each check is a parameter named <statistic><operator> with a number value: statistics count, errors, errorrate, mean, min, max, stddev, sum, throughput or any percentile (p90, p99.9, p99_9); operators lt, le, gt, ge, eq. At least one check is required. Parameter names are case-insensitive. Parameters of the other perf actions are ignored rather than rejected.",
     "patternProperties": {
      "^(count|errors|errorrate|mean|min|max|stddev|sum|throughput|p[0-9]+([._][0-9]+)?)(lt|le|gt|ge|eq)$": {
       "type": "number"
      }
     }
    }
   }
  },
  "/perf/keys": {
   "get": {
    "tags": [
     "perf"
    ],
    "operationId": "perfKeys",
    "summary": "List the keys that have recorded results",
    "description": "Each key with the time it was first and (approximately - refreshed at most once a minute per container) last written. Useful for discovering what a test run actually recorded when the naming convention is not known in advance. Up to 2000 keys; truncated:true when there are more.",
    "parameters": [
     {
      "name": "prefix",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string"
      },
      "description": "Only keys beginning with this string (case-sensitive).",
      "example": "Login"
     }
    ],
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "required": [
          "count",
          "prefix",
          "keys"
         ],
         "properties": {
          "count": {
           "type": "integer"
          },
          "prefix": {
           "type": "string",
           "nullable": true
          },
          "keys": {
           "type": "array",
           "items": {
            "type": "object",
            "required": [
             "key",
             "firstTime",
             "lastTime"
            ],
            "properties": {
             "key": {
              "type": "string"
             },
             "firstTime": {
              "type": "integer"
             },
             "lastTime": {
              "type": "integer"
             }
            }
           }
          }
         }
        },
        "example": {
         "count": 2,
         "prefix": null,
         "keys": [
          {
           "key": "Login",
           "firstTime": 1785400020,
           "lastTime": 1785400260
          },
          {
           "key": "Search",
           "firstTime": 1785400020,
           "lastTime": 1785400020
          }
         ]
        }
       }
      }
     }
    }
   }
  },
  "/perf/clear": {
   "get": {
    "tags": [
     "perf"
    ],
    "operationId": "perfClear",
    "summary": "Delete everything recorded for a key",
    "description": "Removes the aggregates, the interval buckets, any raw points and the registry entry. Deletes are capped at about 5000 items per call: while the response has more:true, call it again. Clear a key before a run to start from zero.",
    "parameters": [
     {
      "name": "key",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string",
       "maxLength": 128
      },
      "description": "Series name, e.g. a transaction name. 1-128 characters: letters, digits and . _ - : @ + =, starting with a letter, digit or +. Case-sensitive. (No \"/\" - use \".\" or \":\" to build hierarchical names.)",
      "example": "Login"
     }
    ],
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "required": [
          "key",
          "deleted",
          "more",
          "comment"
         ],
         "properties": {
          "key": {
           "type": "string"
          },
          "deleted": {
           "type": "integer"
          },
          "more": {
           "type": "boolean"
          },
          "comment": {
           "type": "string"
          }
         }
        },
        "example": {
         "key": "Search",
         "deleted": 2,
         "more": false,
         "comment": "cleared"
        }
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/Error"
     }
    }
   }
  },
  "/perf/export": {
   "get": {
    "tags": [
     "perf"
    ],
    "operationId": "perfExport",
    "summary": "Export the individual points for a key",
    "description": "Returns only points recorded with raw=true, which are kept for 7 days, oldest first. CSV by default (header timestampMs,value,ok; a trailing \"# truncated at limit=N\" line when more exist) or format=json. The aggregates answer almost every question without this; export is for taking the data somewhere else.",
    "parameters": [
     {
      "name": "key",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string",
       "maxLength": 128
      },
      "description": "Series name, e.g. a transaction name. 1-128 characters: letters, digits and . _ - : @ + =, starting with a letter, digit or +. Case-sensitive. (No \"/\" - use \".\" or \":\" to build hierarchical names.)",
      "example": "Login"
     },
     {
      "name": "format",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "default": "csv",
       "enum": [
        "csv",
        "json"
       ]
      },
      "description": "csv (default) or json.",
      "example": "csv"
     },
     {
      "name": "limit",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "default": 10000,
       "minimum": 1,
       "maximum": 50000
      },
      "description": "Maximum points to return, 1-50000 (clamped). Default 10000.",
      "example": 10000
     },
     {
      "name": "since",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer"
      },
      "description": "Only points at or after this UTC epoch second.",
      "example": 1785400020
     },
     {
      "name": "until",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer"
      },
      "description": "Only points at or before this UTC epoch second (inclusive).",
      "example": 1785400319
     }
    ],
    "responses": {
     "200": {
      "description": "text/csv, or application/json when format=json",
      "content": {
       "text/csv": {
        "schema": {
         "type": "string"
        },
        "example": "timestampMs,value,ok\n1785400079000,258.2,false\n1785400079000,294.4,false\n1785400079000,366.8,false\n# truncated at limit=3\n"
       },
       "application/json": {
        "schema": {
         "type": "object",
         "required": [
          "key",
          "count",
          "truncated",
          "points"
         ],
         "properties": {
          "key": {
           "type": "string"
          },
          "count": {
           "type": "integer"
          },
          "truncated": {
           "type": "boolean"
          },
          "points": {
           "type": "array",
           "items": {
            "type": "object",
            "required": [
             "timestampMs",
             "value",
             "ok"
            ],
            "properties": {
             "timestampMs": {
              "type": "integer"
             },
             "value": {
              "type": "number"
             },
             "ok": {
              "type": "boolean"
             }
            }
           }
          }
         }
        },
        "example": {
         "key": "Login",
         "count": 3,
         "truncated": true,
         "points": [
          {
           "timestampMs": 1785400079000,
           "value": 258.2,
           "ok": false
          },
          {
           "timestampMs": 1785400079000,
           "value": 294.4,
           "ok": false
          },
          {
           "timestampMs": 1785400079000,
           "value": 366.8,
           "ok": false
          }
         ]
        }
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/Error"
     }
    }
   }
  }
 }
}
